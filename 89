local function selectTab(name)
    for n, t in pairs(tabs) do
        local on = (n == name)
        t.page.Visible = on
        t.btn.BackgroundTransparency = on and 0 or 1
        t.btn.BackgroundColor3 = ACCENT_D
        t.stroke.Transparency = on and 0 or 1
        t.lbl.TextColor3 = on and TXT or SUB
        setIconColor(t.ico, on and ACCENT or SUB)
    end
    currentTab = name
end

local function newTab(name, icon, heading, subheading)
    local btn = mk("TextButton", { BackgroundTransparency = 1, Text = "", AutoButtonColor = false,
        Size = UDim2.new(1, 0, 0, 26) }, tabScroll)
    corner(btn, 8)
    local st = stroke(btn, ACCENT, 1, 1)
