    local lbl = text(btn, name, 11, SUB, true)
    lbl.Position = UDim2.fromOffset(32, 5); lbl.Size = UDim2.new(1, -36, 0, 16)

    local page = mk("Frame", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Visible = false }, content)
    local h = text(page, heading, 18, TXT, true)
    h.Size = UDim2.new(1, 0, 0, 22)
    local sh = text(page, subheading, 11, SUB)
    sh.Position = UDim2.fromOffset(0, 22); sh.Size = UDim2.new(1, 0, 0, 14)
    local cols = mk("Frame", { BackgroundTransparency = 1, Position = UDim2.fromOffset(0, 44),
        Size = UDim2.new(1, 0, 1, -44) }, page)
    local function column(xs, ws)
        local sf = mk("ScrollingFrame", { BackgroundTransparency = 1, BorderSizePixel = 0,
            Position = UDim2.new(xs, xs > 0 and 4 or 0, 0, 0), Size = UDim2.new(ws, -4, 1, 0),
            ScrollBarThickness = 2, ScrollBarImageColor3 = ACCENT, AutomaticCanvasSize = Enum.AutomaticSize.Y,
            CanvasSize = UDim2.new() }, cols)
        list(sf, 8); pad(sf, 0, 0, 4, 8)
        return sf
    end
    local T = { page = page, btn = btn, lbl = lbl, ico = ico, stroke = st, name = name,
        left = column(0, 0.56), right = column(0.56, 0.44) }
    tabs[name] = T; tabOrder[#tabOrder + 1] = name
