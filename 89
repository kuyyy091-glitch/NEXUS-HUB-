local function newCard(col, title)
    local card = mk("Frame", { BackgroundColor3 = CARD, Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y }, col)
    corner(card, 10); stroke(card, LINE, 1, 0.35); pad(card, 10, 10)
    list(card, 8)
    local hd = mk("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 14), LayoutOrder = 0 }, card)
    local bar = mk("Frame", { BackgroundColor3 = ACCENT, Size = UDim2.fromOffset(3, 12), Position = UDim2.fromOffset(0, 1) }, hd)
    corner(bar, 2)
    local tl = text(hd, title, 11, TXT, true)
    tl.Position = UDim2.fromOffset(10, 0); tl.Size = UDim2.new(1, -10, 1, 0)

    local C = {}
    local order = 1
    local function nextOrder() order = order + 1; return order end

    function C:Label(str)
        local l = text(card, str, 10, SUB); l.LayoutOrder = nextOrder(); l.TextWrapped = true
        l.TextTruncate = Enum.TextTruncate.None; l.AutomaticSize = Enum.AutomaticSize.Y
        l.Size = UDim2.new(1, 0, 0, 12)
        return l
    end

    function C:Toggle(label, desc, default, cb)
        local h = desc and 38 or 26
        local row = mk("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, h), LayoutOrder = nextOrder() }, card)
        local l = text(row, label, 12, TXT, true); l.Size = UDim2.new(1, -50, 0, 16)
        l.Position = UDim2.fromOffset(0, desc and 2 or 5)
        if desc then
            local d = text(row, desc, 10, SUB); d.Position = UDim2.fromOffset(0, 19); d.Size = UDim2.new(1, -50, 0, 13)
        end
        local sw = mk("Frame", { BackgroundColor3 = CARD2, AnchorPoint = Vector2.new(1, 0.5),
            Position = UDim2.new(1, 0, 0.5, 0), Size = UDim2.fromOffset(36, 18) }, row)
        corner(sw, 9); local ss = stroke(sw, LINE, 1, 0)
        local knob = mk("Frame", { BackgroundColor3 = SUB, Position = UDim2.fromOffset(2, 2), Size = UDim2.fromOffset(14, 14) }, sw)
        corner(knob, 7)
        local state = default and true or false
        local obj = {}
        local function render()
            tween(knob, 0.15, { Position = state and UDim2.fromOffset(20, 2) or UDim2.fromOffset(2, 2),
                BackgroundColor3 = state and Color3.new(1, 1, 1) or SUB })
            tween(sw, 0.15, { BackgroundColor3 = state and ACCENT or CARD2 })
            ss.Color = state and ACCENT or LINE
        end
        function obj.Set(v, silent)
            state = v and true or false; render()
            if cb and not silent then task.spawn(cb, state) end
        end
        function obj.Get() return state end
        local hit = mk("TextButton", { BackgroundTransparency = 1, Text = "", Size = UDim2.fromScale(1, 1) }, row)
        bind(hit.MouseButton1Click, function() obj.Set(not state) end)
        render()
        if default and cb then task.spawn(cb, state) end
        return obj
    end

