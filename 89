local function installSpy()
    if spyHooked then return true end
    if not (hookmetamethod and getnamecallmethod) then return false end
    local old
    local function handler(self, ...)
        local m = getnamecallmethod()
        if spyOn and (m == "FireServer" or m == "InvokeServer") and typeof(self) == "Instance"
            and (not checkcaller or not checkcaller()) then
            local args = table.pack(...)
            pcall(function()
                local parts = {}
                for i = 1, args.n do parts[i] = ser(args[i], 0, {}, "") end
                spyLine("REMOTE", self:GetFullName() .. ":" .. m .. "(" .. table.concat(parts, ", ") .. ")")
            end)
        end
        return old(self, ...)
    end
    old = hookmetamethod(game, "__namecall", newcclosure and newcclosure(handler) or handler)
    spyHooked = true
    return true
end
