walkTo = function(pos, stopDist, timeout)
    local hum, root = getHum(), getRoot()
    if not (hum and root and pos) then return false end
    stopDist, timeout = stopDist or 6, timeout or 40
    local t0 = os.clock()
    local waypoints
    local path = PathfindingService:CreatePath({ AgentRadius = 2, AgentHeight = 5, AgentCanJump = true })
    local ok = pcall(function() path:ComputeAsync(root.Position, pos) end)
    if ok and path.Status == Enum.PathStatus.Success then waypoints = path:GetWaypoints() end
    local function reached() local r = getRoot(); return r and (r.Position - pos).Magnitude <= stopDist end
    if waypoints then
        for _, wp in ipairs(waypoints) do
            if reached() or not alive then break end
            if wp.Action == Enum.PathWaypointAction.Jump then hum.Jump = true end
            hum:MoveTo(wp.Position)
            local done = false
            local c = hum.MoveToFinished:Connect(function() done = true end)
            local t1 = os.clock()
            while not done and os.clock() - t1 < 4 and not reached() and alive do task.wait(0.1) end
            c:Disconnect()
            if os.clock() - t0 > timeout then break end
        end
    end
    while not reached() and alive and os.clock() - t0 < timeout do
        hum:MoveTo(pos); task.wait(0.2)
    end
    return reached()
end

local bypassTP, TPStop
do
    local conn, bodyPos, busy = nil, nil, false
    local function cleanup()
        if conn then conn:Disconnect(); conn = nil end
        if bodyPos then pcall(function() bodyPos:Destroy() end); bodyPos = nil end
        local h = getHum()
        pcall(function()
            if h and h.Parent then
                h.PlatformStand = false
                h:SetStateEnabled(Enum.HumanoidStateType.FallingDown, true)
                h:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, true)
                h:ChangeState(Enum.HumanoidStateType.Freefall)
            end
        end)
        busy = false
    end

    bypassTP = function(target, block)
        if busy then return false end
        local root, hum = getRoot(), getHum()
        if not (root and hum) then return false end
        if typeof(target) == "Vector3" then target = CFrame.new(target) end
        busy = true
        if hum.SeatPart then hum.Sit = false; task.wait(0.3) end
        pcall(function()
            hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
            hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
        end)
        local floatCF = target * CFrame.new(0, 5, 0)
        pcall(function() LP.Character:PivotTo(floatCF) end)
        if (root.Position - floatCF.Position).Magnitude > 3 then root.CFrame = floatCF end
        pcall(function() root.AssemblyLinearVelocity = Vector3.zero; root.AssemblyAngularVelocity = Vector3.zero end)
        bodyPos = Instance.new("BodyPosition")
        bodyPos.Position = floatCF.Position
        bodyPos.MaxForce = Vector3.new(1e5, 1e5, 1e5)
        bodyPos.P, bodyPos.D = 1e4, 500
        bodyPos.Parent = root
        pcall(function() hum.PlatformStand = true end)
        conn = RunService.Heartbeat:Connect(function()
            if not root or not root.Parent then return end
            if (root.Position - floatCF.Position).Magnitude > 2 then
                pcall(function() root.CFrame = floatCF end)
                pcall(function() root.AssemblyLinearVelocity = Vector3.zero; root.AssemblyAngularVelocity = Vector3.zero end)
            end
        end)
        local done = false
        task.delay(math.random(40, 50) / 10, function() cleanup(); done = true end)
        if block then while not done and alive do task.wait(0.1) end end
        return true
    end
    TPStop = cleanup
end

