local crcT
local function crc32(s)
    if not crcT then
        crcT = {}
        for i = 0, 255 do
            local c = i
            for _ = 1, 8 do
                if bit32.band(c, 1) == 1 then c = bit32.bxor(bit32.rshift(c, 1), 0xEDB88320)
                else c = bit32.rshift(c, 1) end
            end
            crcT[i] = c
        end
    end
    local c, n, i, done = 0xFFFFFFFF, #s, 1, 0
    while i <= n do
        local j = math.min(i + 4095, n)
        local bytes = { string.byte(s, i, j) }
        for k = 1, #bytes do
            c = bit32.bxor(crcT[bit32.band(bit32.bxor(c, bytes[k]), 0xFF)], bit32.rshift(c, 8))
        end
        done = done + (j - i + 1)
        i = j + 1
        if done > 400000 then done = 0; task.wait() end
    end
    return bit32.bxor(c, 0xFFFFFFFF)
end

local function buildZip(files, names)
    local t = os.date("*t")
    local dtime = bit32.bor(bit32.lshift(t.hour, 11), bit32.lshift(t.min, 5), math.floor(t.sec / 2))
    local ddate = bit32.bor(bit32.lshift(math.max(t.year - 1980, 0), 9), bit32.lshift(t.month, 5), t.day)
    local parts, entries, offset = {}, {}, 0
    for _, name in ipairs(names) do
        local data = files[name]
        local crc = crc32(data)
        local lh = string.pack("<I4I2I2I2I2I2I4I4I4I2I2", 0x04034b50, 20, 0x0800, 0, dtime, ddate, crc, #data, #data, #name, 0)
        parts[#parts + 1] = lh; parts[#parts + 1] = name; parts[#parts + 1] = data
        entries[#entries + 1] = { name = name, crc = crc, size = #data, offset = offset }
        offset = offset + #lh + #name + #data
    end
    local cd = {}
    for _, e in ipairs(entries) do
        cd[#cd + 1] = string.pack("<I4I2I2I2I2I2I2I4I4I4I2I2I2I2I2I4I4",
            0x02014b50, 20, 20, 0x0800, 0, dtime, ddate, e.crc, e.size, e.size, #e.name, 0, 0, 0, 0, 0, e.offset)
        cd[#cd + 1] = e.name
    end
    local cdData = table.concat(cd)
    local eocd = string.pack("<I4I2I2I2I2I4I4I2", 0x06054b50, 0, 0, #entries, #entries, #cdData, offset, 0)
    return table.concat(parts) .. cdData .. eocd
end

local function multipart(fields, fileField, fname, data)
    local boundary = "----MAHIRA" .. tostring(math.random(100000, 999999)) .. tostring(math.random(100000, 999999))
    local out = {}
    for k, v in pairs(fields) do
        out[#out + 1] = "--" .. boundary .. "\r\nContent-Disposition: form-data; name=\"" .. k .. "\"\r\n\r\n" .. v .. "\r\n"
    end
    out[#out + 1] = "--" .. boundary .. "\r\nContent-Disposition: form-data; name=\"" .. fileField
        .. "\"; filename=\"" .. fname .. "\"\r\nContent-Type: application/zip\r\n\r\n" .. data .. "\r\n--" .. boundary .. "--\r\n"
    return table.concat(out), "multipart/form-data; boundary=" .. boundary
end

local function uploadZip(fname, zip)
    local req = (syn and syn.request) or http_request or request or (http and http.request)
    if not req then return nil, "executor ไม่มี request/http_request" end
    local hosts = {
        { name = "litterbox", url = "https://litterbox.catbox.moe/resources/internals/api.php",
          fields = { reqtype = "fileupload", time = "72h" }, field = "fileToUpload", ua = "Mozilla/5.0" },
        { name = "0x0.st", url = "https://0x0.st",
          fields = { expires = "72" }, field = "file", ua = "curl/8.5.0" },
    }
    local errors = {}
    for _, h in ipairs(hosts) do
        local body, ctype = multipart(h.fields, h.field, fname, zip)
        local ok, res = pcall(req, { Url = h.url, Method = "POST",
            Headers = { ["Content-Type"] = ctype, ["User-Agent"] = h.ua }, Body = body })
        if ok and type(res) == "table" then
            local text = tostring(res.Body or ""):gsub("%s+$", "")
            local code = res.StatusCode or res.Status
            if (code == 200 or res.Success) and text:match("^https?://") then return text end
            errors[#errors + 1] = h.name .. ": HTTP " .. tostring(code) .. " " .. text:sub(1, 60)
        else
            errors[#errors + 1] = h.name .. ": " .. tostring(res):sub(1, 60)
        end
    end
    return nil, table.concat(errors, " | ")
end

local function saveFiles(files, tag)
    local names = {}
    for name in pairs(files) do names[#names + 1] = name end
    table.sort(names)

    if writefile and makefolder then
        pcall(function() if isfolder and not isfolder(DUMP_DIR) then makefolder(DUMP_DIR) end end)
        for _, name in ipairs(names) do pcall(writefile, DUMP_DIR .. "/" .. name, files[name]) end
    end

    local okz, zip = pcall(buildZip, files, names)
    if not okz then return "สร้าง ZIP ไม่สำเร็จ: " .. tostring(zip) end
    local zname = "MAHIRA_" .. (tag or "DUMP") .. "_" .. tostring(game.PlaceId) .. ".zip"
    local saved = writefile and pcall(writefile, zname, zip)

    local link, err = uploadZip(zname, zip)
    if link then
        pcall(function() if writefile then writefile("MAHIRA_" .. (tag or "DUMP") .. "_" .. tostring(game.PlaceId) .. "_link.txt", link) end end)
        local copied = setclipboard and pcall(setclipboard, link)
        print("[MAHIRA] LINK: " .. link)
        return ("ได้ลิงก์ดาวน์โหลด ZIP แล้ว (อยู่ ~72 ชม.)\n%s%s"):format(link, copied and "\n(คัดลอกลงคลิปบอร์ดแล้ว)" or "")
    end
    return ("อัปโหลดไม่สำเร็จ: %s%s"):format(err or "?", saved and ("\nไฟล์ ZIP อยู่ที่ workspace/" .. zname) or "")
end

