local function lucideAsset(kind)
    if not Lucide then return nil end
    for _, n in ipairs(LUCIDE_NAMES[kind] or {}) do
        local ok, a = pcall(Lucide.GetAsset, n, 48)
        if ok and a then return a end
    end
end

local function setIconColor(ic, color)
    if ic:IsA("ImageLabel") then ic.ImageColor3 = color; return end
    for _, d in ipairs(ic:GetDescendants()) do
        if d:IsA("UIStroke") then d.Color = color
        elseif d:IsA("Frame") and d:GetAttribute("F") then d.BackgroundColor3 = color end
    end
end
local function newIcon(parent, kind, size, color)
    local a = lucideAsset(kind)
    if a then
        return mk("ImageLabel", { BackgroundTransparency = 1, Size = UDim2.fromOffset(size, size),
            Image = a.Url, ImageRectSize = a.ImageRectSize, ImageRectOffset = a.ImageRectOffset,
            ImageColor3 = color or TXT, ScaleType = Enum.ScaleType.Fit }, parent)
    end
    local ic = mk("Frame", { BackgroundTransparency = 1, Size = UDim2.fromOffset(size, size) }, parent)
    ICONS[kind](ic)
    setIconColor(ic, color or TXT)
    return ic
end

