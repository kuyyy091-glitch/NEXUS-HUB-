local DUMP_DIR = "MAHIRA_DUMP"
local function ser(v, depth, seen, ind)
    depth = depth or 0; ind = ind or ""
    local t = typeof(v)
    if t == "string" then return string.format("%q", v)
    elseif t == "number" or t == "boolean" or t == "nil" then return tostring(v)
    elseif t == "Vector3" or t == "Vector2" or t == "Color3" or t == "CFrame" or t == "UDim2" or t == "EnumItem" then
        return t .. ":" .. tostring(v)
    elseif t == "Instance" then return "<" .. v.ClassName .. ":" .. v:GetFullName() .. ">"
    elseif t == "table" then
        if seen[v] then return "<cycle>" end
        if depth >= 5 then return "{...}" end
        seen[v] = true
        local out, n = { "{" }, 0
        for k, val in pairs(v) do
            n = n + 1
            if n > 300 then out[#out + 1] = ind .. "  ..."; break end
            if typeof(val) ~= "function" then
                out[#out + 1] = ind .. "  [" .. ser(k, depth + 1, seen, "") .. "] = " .. ser(val, depth + 1, seen, ind .. "  ") .. ","
            end
        end
        out[#out + 1] = ind .. "}"
        seen[v] = nil
        return table.concat(out, "\n")
    end
    return "<" .. t .. ">"
end

local function dumpTree(root, maxDepth, maxLines, out)
    local count = 0
    local function walk(inst, depth)
        if count >= maxLines then return end
        count = count + 1
        local extra = ""
        if inst:IsA("BasePart") then extra = " pos=" .. tostring(inst.Position) end
        if inst:IsA("ProximityPrompt") then extra = (" action=%q object=%q"):format(inst.ActionText, inst.ObjectText) end
        out[#out + 1] = string.rep("  ", depth) .. inst.Name .. " (" .. inst.ClassName .. ")" .. extra
        if depth < maxDepth then
            for _, ch in ipairs(inst:GetChildren()) do walk(ch, depth + 1) end
        end
        if count % 400 == 0 then task.wait() end
    end
    walk(root, 0)
end

local function fmtV(v) return ("%.1f, %.1f, %.1f"):format(v.X, v.Y, v.Z) end
local function dumpPosTree(root, maxDepth, maxLines, out)
    local count = 0
    local function walk(inst, depth, md)
        if count >= maxLines then return end
        count = count + 1
        local extra = ""
        if inst:IsA("Model") then
            md = md + 1
            local ok, pv = pcall(function() return inst:GetPivot().Position end)
            if ok then extra = " pos=" .. fmtV(pv) end
        elseif inst:IsA("BasePart") then extra = " pos=" .. fmtV(inst.Position)
        elseif inst:IsA("Attachment") then extra = " pos=" .. fmtV(inst.WorldPosition)
        elseif inst:IsA("ProximityPrompt") then
            extra = (" PROMPT action=%q object=%q hold=%s dist=%s"):format(inst.ActionText, inst.ObjectText, tostring(inst.HoldDuration), tostring(inst.MaxActivationDistance))
        end
        local okA, attrs = pcall(function() return inst:GetAttributes() end)
        if okA and next(attrs) then
            local a = {}
            for k, v in pairs(attrs) do a[#a + 1] = k .. "=" .. tostring(v) end
            table.sort(a)
            extra = extra .. " {" .. table.concat(a, ", ") .. "}"
        end
        out[#out + 1] = string.rep("  ", depth) .. inst.Name .. " (" .. inst.ClassName .. ")" .. extra
        if depth < maxDepth and md <= 2 then
            for _, ch in ipairs(inst:GetChildren()) do walk(ch, depth + 1, md) end
        end
        if count % 400 == 0 then task.wait() end
    end
    walk(root, 0, 0)
end

