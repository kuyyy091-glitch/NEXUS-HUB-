        v.Position = UDim2.fromScale(0.6, 0); v.Size = UDim2.new(0.4, 0, 0, 14)
        local track = mk("Frame", { BackgroundColor3 = CARD2, Position = UDim2.fromOffset(0, 24), Size = UDim2.new(1, 0, 0, 4) }, row)
        corner(track, 2)
        local fill = mk("Frame", { BackgroundColor3 = ACCENT, Size = UDim2.fromScale(0, 1) }, track)
        corner(fill, 2)
        local knob = mk("Frame", { BackgroundColor3 = Color3.new(1, 1, 1), AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.fromScale(0, 0.5), Size = UDim2.fromOffset(12, 12) }, track)
        corner(knob, 6)
        local value = default
        local obj = {}
        local function setVal(n, silent)
            n = math.clamp(math.floor(n + 0.5), min, max); value = n
            local a = (n - min) / (max - min)
            fill.Size = UDim2.fromScale(a, 1); knob.Position = UDim2.fromScale(a, 0.5)
            v.Text = tostring(n) .. suffix
            if cb and not silent then cb(n) end
        end
        obj.Set = setVal
        local hit = mk("TextButton", { BackgroundTransparency = 1, Text = "", Position = UDim2.fromOffset(0, 16),
            Size = UDim2.new(1, 0, 0, 22) }, row)
        local drag = false
        local function upd(x)
            local a = math.clamp((x - track.AbsolutePosition.X) / math.max(1, track.AbsoluteSize.X), 0, 1)
            setVal(min + a * (max - min))
        end
        bind(hit.InputBegan, function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
                drag = true; upd(i.Position.X)
            end
        end)
        bind(UIS.InputChanged, function(i)
            if drag and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
