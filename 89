local Lucide
do
    local CACHE = "MAHIRA_lucide.luau"
    local function load(src)
        local ok, lib = pcall(function() return loadstring(src)() end)
        if ok and type(lib) == "table" and type(lib.GetAsset) == "function" then return lib end
    end
    if isfile and readfile and isfile(CACHE) then
        local okr, src = pcall(readfile, CACHE)
        if okr then Lucide = load(src) end
    end
    if not Lucide and writefile then
        task.spawn(function()
            local ok, src = pcall(function() return game:HttpGet(LUCIDE_URL) end)
            if ok and type(src) == "string" and #src > 1000 and load(src) then pcall(writefile, CACHE, src) end
        end)
    end
end
